{
  "name": "dio-explorer-mcp",
  "version": "1.0.0",
  "description": "MCP Server para o DIO Explorer — expõe trilhas, desafios e certificados via ferramentas MCP (stdio, HTTP/SSE e API REST)",
  "type": "module",
  "main": "./build/index.js",
  "bin": {
    "dio-explorer-mcp": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "start:http": "node build/http-server.js",
    "dev": "tsc --watch",
    "clean": "node -e \"require('fs').rmSync('./build', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.15.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "dio",
    "trilhas",
    "formacao",
    "ai",
    "ibm-bob"
  ],
  "author": "DIO Explorer",
  "license": "MIT"
}
