# Variáveis de ambiente para o DIO Explorer MCP Server
# Copie este arquivo para .env e preencha os valores

# ── Servidor HTTP ────────────────────────────────────────────────────────────
# Porta do servidor HTTP/SSE (padrão: 3000)
PORT=3000

# Host de bind (padrão: 0.0.0.0 para aceitar conexões externas)
HOST=0.0.0.0

# ── Autenticação via API Key (opcional) ──────────────────────────────────────
# Defina para habilitar proteção por API Key nos endpoints HTTP
# Se não definida, o servidor roda sem autenticação (apenas para desenvolvimento)
# DIO_API_KEY=sua-chave-secreta-aqui

# ── Paths ────────────────────────────────────────────────────────────────────
# Caminho para o arquivo de trilhas (relativo à pasta mcp/)
# Padrão: ../data/trilhas_dio.json
# TRILHAS_JSON_PATH=../data/trilhas_dio.json

# ── CORS ─────────────────────────────────────────────────────────────────────
# Origins permitidas para requisições HTTP (separadas por vírgula)
# Use * para permitir qualquer origem (não recomendado em produção)
# CORS_ORIGINS=https://seu-app.com,https://outro-app.com
CORS_ORIGINS=*
